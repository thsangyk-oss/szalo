# Szalo server config — copy to .env if you want to override defaults

# TCP port the API listens on (1-65535).
# Default 13113. (Note: 113113 is not a valid TCP port.)
# PORT=13113

# CORS allow-list (comma-separated). Use "*" to allow any origin.
# Electron app makes requests from "file://" / null origin,
# so "*" is the easiest setting for desktop clients.
# CLIENT_ORIGIN=*

# Optional: directory for cached state (session, conversations, uploads, db.json).
# Defaults to ./.zalo-manager next to the server's working directory.
# DATA_DIR=

# Optional: explicit path to the JSON config store (API key + admin password hash).
# Defaults to <DATA_DIR>/db.json.
# DB_FILE=

# NOTE: There is no API_KEY env var anymore. The server generates the API key
# itself on first boot and stores it in db.json. Open /admin (default password
# "123456") to view, copy, or rotate it.
