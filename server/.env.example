# Szalo server config — copy to .env and edit

# TCP port the API listens on (1-65535).
# Default 13113. (Note: 113113 is not a valid TCP port.)
PORT=13113

# API key required for every request.
# Generate a long random string and share it with the desktop app.
# Required — the server refuses to start with an empty key.
API_KEY=replace-me-with-a-long-random-string

# CORS allow-list (comma-separated). Use "*" to allow any origin.
# Electron app makes requests from "file://" / null origin,
# so "*" is the easiest setting for desktop clients.
CLIENT_ORIGIN=*

# Optional: directory for cached state (session, conversations, uploads).
# Defaults to ./.zalo-manager next to the server's working directory.
# DATA_DIR=
