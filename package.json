{
  "name": "zalo-manager",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:electron": "node electron/run-dev.cjs",
    "build": "tsc -b && vite build",
    "build:icons": "node electron/generate-icons.cjs",
    "build:server": "node electron/build-server.cjs",
    "lint": "eslint .",
    "smoke": "tsx scripts/smoke.ts",
    "start": "tsx server/index.ts",
    "start:bg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-server.ps1",
    "start:prod": "npm run build && npm start",
    "start:electron": "npm run build && npm run build:server && electron .",
    "preview": "vite preview",
    "pack": "npm run build && npm run build:icons && npm run build:server && electron-builder --dir",
    "dist": "npm run build && npm run build:icons && npm run build:server && electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "zca-js": "^2.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.0",
    "electron": "35.0.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lucide-react": "^1.17.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.zalo-manager.app",
    "productName": "Zalo Manager",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "!electron/server.cjs",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/esbuild/**/*",
      "!node_modules/typescript/**/*",
      "!node_modules/vite/**/*",
      "!node_modules/eslint*/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "type": "commonjs"
    },
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/server.cjs",
        "to": "server.cjs"
      },
      {
        "from": ".zalo-manager",
        "to": ".zalo-manager",
        "filter": [
          "session.json"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/icon.png",
      "uninstallerIcon": "electron/icon.png"
    }
  }
}
